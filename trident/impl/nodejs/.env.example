# cTrader Open API credentials
# Get these from: https://openapi.ctrader.com/apps
CTRADER_CLIENT_ID=your_client_id
CTRADER_CLIENT_SECRET=your_client_secret

# Set by running: npm run auth:ctrader (or paste directly from the portal for sandbox)
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Unix timestamp when the access token expires — set automatically by auth:ctrader
# and updated in-place whenever the engine refreshes the token.
# For sandbox tokens (expiresIn=2628000): run `echo $(($(date +%s) + 2628000))`
CTRADER_TOKEN_EXPIRES_AT=

# Symbol to stream prices for (default: US500)
CTRADER_SYMBOL=US500

# Optional: pin a specific trading account by its numeric cTrader ID
# CTRADER_ACCOUNT_ID=

# Optional: skip the symbol list lookup and use this ID directly for subscriptions.
# Required on demo environments that don't support SYMBOL_LIST_REQ.
# Find the ID in the cTrader portal under your account's instrument list.
# CTRADER_SYMBOL_ID=

# WebSocket endpoint — omit for live trading, set for demo/sandbox:
# CTRADER_WS_URL=wss://demo.ctraderapi.com:5036

# Set to true for demo environments — the demo server rejects client heartbeats
# and closes the connection if you send them.
# CTRADER_NO_HEARTBEAT=true

# ---- AI signal extraction (Import from screenshots feature) ----
# Optional. If unset, the Import button still uploads + saves screenshots,
# but the form is not auto-filled and the UI shows "AI extraction unavailable".

# Provider selector — default "openai". Future values: "anthropic", "gemini".
# TRIDENT_AI_PROVIDER=openai

# OpenAI credentials
OPENAI_API_KEY=
# Override the default vision model. Default: gpt-4o-2024-11-20
# OPENAI_MODEL=gpt-4o-2024-11-20
# Override the API endpoint (e.g. for an Azure OpenAI / proxy deployment).
# OPENAI_BASE_URL=

# ---- App settings ----
# Dashboard port (default: 3000). Change if 3000 is already in use on your machine.
# TRIDENT_WEB_PORT=3000

# Log verbosity: error | warn | info | debug (default: info)
# LOG_LEVEL=info
