{
  "name": "trident",
  "version": "0.1.0",
  "description": "Trident strategy — qs-signal-engine POC",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --experimental-vm-modules dist/index.js",
    "dev": "tsx src/index.ts",
    "dev:fresh": "rm -f logs/engine-state.json logs/trident.log && rm -f setups/qs_setup_*.yaml && tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:ctrader": "tsx scripts/ctrader-auth.ts",
    "smoke:order": "tsx scripts/smoke-order.ts",
    "simulate": "tsx scripts/simulate-trade.ts",
    "list:symbols": "tsx scripts/list-symbols.ts",
    "test:coverage": "vitest run --coverage",
    "eval": "promptfoo eval --config evals/promptfooconfig.yaml"
  },
  "_comment_langchain": "LangChain/LangGraph POC — MIT, no per-call cost; same underlying OpenAI API",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@langchain/core": "~0.3.80",
    "@langchain/langgraph": "~0.2.74",
    "@langchain/openai": "~0.4.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@types/express": "^5.0.6",
    "chokidar": "^3.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "js-yaml": "^4.1.0",
    "openai": "^6.35.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^1.6.1",
    "promptfoo": "^0.121.12",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  }
}
